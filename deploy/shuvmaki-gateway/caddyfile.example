# TLS terminator for exe.dev / kimaki.exe.xyz.
# Discord OAuth redirect URIs must be https (except localhost).
# Point DNS:
#   kimaki.exe.xyz                 -> this Caddy host -> 127.0.0.1:8080
#   discord-gateway.kimaki.exe.xyz -> this Caddy host -> 127.0.0.1:7878
# WebSocket upgrade is required on the gateway host. CLI REST calls the same
# host over https (KIMAKI_GATEWAY_PROXY_URL wss is swapped to https).
#
# Caddy is not a compose service. Run it on the host after
# `docker compose up --build`. compose binds onboarding and gateway-proxy to
# loopback so those ports are not reachable on the public interface.

kimaki.exe.xyz {
	reverse_proxy 127.0.0.1:8080
}

discord-gateway.kimaki.exe.xyz {
	reverse_proxy 127.0.0.1:7878
}
