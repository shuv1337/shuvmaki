# Point a shuvmaki / kimaki CLI at this self-hosted stack instead of kimaki.dev.
# Copy values into the shell that runs `kimaki --gateway`. Do not commit secrets.

KIMAKI_WEBSITE_URL=https://kimaki.exe.xyz
KIMAKI_GATEWAY_PROXY_URL=wss://discord-gateway.kimaki.exe.xyz

# Discord Application ID of YOUR bot (General Information -> Application ID).
# Required when KIMAKI_WEBSITE_URL is not https://kimaki.dev. Leave unset here
# until you paste Kyle's Application ID. Do not use 1477605701202481173.
KIMAKI_GATEWAY_APP_ID=
