# Copy to .env in this directory. Never commit real values.
# Discord Developer Portal secrets belong to YOUR application. This repo
# does not register a Discord app and does not ship tokens.

# Bot token from Discord Developer Portal -> Bot -> Token
DISCORD_BOT_TOKEN=

# OAuth2 -> Client ID. For a Discord application this is the same string as
# General Information -> Application ID.
DISCORD_CLIENT_ID=

# OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=

# General Information -> Application ID. CLI env KIMAKI_GATEWAY_APP_ID uses this.
# Required. Do not use the kimaki.dev bot id 1477605701202481173.
DISCORD_APPLICATION_ID=

# Random HMAC key for signing OAuth state. Not a Discord secret.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Public HTTPS origin of the onboarding HTTP service (no trailing slash).
# Discord redirect URI must be exactly: ${PUBLIC_WEBSITE_URL}/api/auth/callback/discord
PUBLIC_WEBSITE_URL=https://kimaki.exe.xyz

# Public WebSocket origin of gateway-proxy. CLI KIMAKI_GATEWAY_PROXY_URL uses this.
# REST is the same host with https (CLI swaps wss -> https).
PUBLIC_GATEWAY_WS_URL=wss://discord-gateway.kimaki.exe.xyz

POSTGRES_USER=shuvmaki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shuvmaki
